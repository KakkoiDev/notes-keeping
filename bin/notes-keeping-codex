#!/usr/bin/env bun
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { basename, dirname, join, resolve } from 'node:path'
import { spawnSync } from 'node:child_process'

import { logRow } from '../hooks/logs'
import { addLogs, addUpdate, create, fileName, logsHint, projectName, sections, setObjectives, setTodo } from '../hooks/notes'
import { changeLine, context, cycleItem, format, idOf, items, keyOf, markOf, parse, type Change, type Status, withIds } from '../hooks/todo'

type HookInput = { session_id?: unknown; cwd?: unknown; hook_event_name?: unknown; source?: unknown }

const statuses = new Set<Status>(['todo', 'in-progress', 'done', 'declined', 'blocked', 'paused'])
const marks: Record<string, Status> = { '[ ]': 'todo', '[~]': 'in-progress', '[x]': 'done', '[-]': 'declined', '[!]': 'blocked', '[/]': 'paused' }

function fail(message: string, code = 2): never {
  console.error(`notes-keeping-codex: ${message}`)
  process.exit(code)
}

function notesDir(): string {
  return resolve(process.env.NOTES_KEEPING_DIR || join(homedir(), '.notes-keeping'))
}

function stateDir(): string {
  return resolve(process.env.NOTES_KEEPING_CODEX_STATE || process.env.PLUGIN_DATA || join(notesDir(), '.codex'))
}

function safeSession(id: string): string {
  return id.replace(/[^A-Za-z0-9_.-]/g, '_')
}

function bindingPath(id: string): string {
  return join(stateDir(), 'sessions', `${safeSession(id)}.json`)
}

function read(path: string): string {
  try {
    return readFileSync(path, 'utf8')
  } catch (error) {
    fail(error instanceof Error ? error.message : String(error), 1)
  }
}

function commit(path: string, subject: string): void {
  const dir = dirname(path)
  if (!existsSync(join(dir, '.git'))) spawnSync('git', ['-C', dir, 'init', '-q'], { stdio: 'ignore' })
  spawnSync('git', ['-C', dir, 'add', '-A'], { stdio: 'ignore' })
  spawnSync('git', ['-C', dir, 'commit', '-q', '-m', `${subject}: ${basename(path)}`], { stdio: 'ignore' })
}

function save(path: string, md: string, subject: string): void {
  writeFileSync(path, md)
  commit(path, subject)
}

function bridgePath(): string | undefined {
  if (process.env.NOTES_KEEPING_BRIDGE) return resolve(process.env.NOTES_KEEPING_BRIDGE)
  const root = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' })
  const candidate = root.status === 0 ? join(root.stdout.trim(), 'config', 'notes-keeping-bridge') : join(process.cwd(), 'config', 'notes-keeping-bridge')
  return existsSync(candidate) ? candidate : undefined
}

function notify(path: string, changes: readonly Change[]): void {
  const bridge = bridgePath()
  if (bridge === undefined || changes.length === 0) return
  const input = `${changes.map(change => changeLine(change, 'codex')).join('\n')}\n`
  const done = spawnSync(bridge, ['notify', path], { input, encoding: 'utf8', timeout: 10_000 })
  if (done.status !== 0) console.error(`notes-keeping-codex: bridge notify failed: ${(done.stderr || String(done.error || done.status)).trim().split('\n').pop()}`)
}

function existingSession(id: string): string | undefined {
  if (!existsSync(notesDir())) return undefined
  for (const name of readdirSync(notesDir())) {
    const path = join(notesDir(), name)
    if (name.endsWith('.md') && sections(read(path)).sessions.includes(id)) return path
  }
  return undefined
}

function ensureSession(id: string, cwd: string): string {
  const binding = bindingPath(id)
  if (existsSync(binding)) {
    try {
      const path = JSON.parse(read(binding)).path
      if (typeof path === 'string' && existsSync(path)) return path
    } catch {}
  }
  mkdirSync(notesDir(), { recursive: true })
  mkdirSync(dirname(binding), { recursive: true })
  const found = existingSession(id)
  const path = found || join(notesDir(), fileName(projectName(cwd), id, Date.now(), readdirSync(notesDir())))
  if (!found) save(path, create('', id), 'session')
  writeFileSync(binding, `${JSON.stringify({ path })}\n`)
  return path
}

function executable(): string {
  return process.env.PLUGIN_ROOT ? join(process.env.PLUGIN_ROOT, 'bin', 'notes-keeping-codex') : resolve(process.argv[1] || 'notes-keeping-codex')
}

function instructions(path: string): string {
  const command = `${executable()} --file ${JSON.stringify(path)}`
  return [
    `Codex session notes: ${path}`,
    'Do not edit this file directly. Keep its todo statuses current yourself.',
    `Use ${command} status <id-or-exact-label> <todo|in-progress|done|declined|blocked|paused> [--reason <text>] to change a status and log it.`,
    `Use ${command} add <text>, objective <text>, or update <text> for other logged changes; use show to read the file.`,
  ].join('\n')
}

function hook(): void {
  let input: HookInput
  try {
    input = JSON.parse(readFileSync(0, 'utf8')) as HookInput
  } catch {
    fail('hook input is not valid JSON')
  }
  if (typeof input.session_id !== 'string') fail('hook input has no session_id')
  const cwd = typeof input.cwd === 'string' ? input.cwd : process.cwd()
  const path = ensureSession(input.session_id, cwd)
  if (input.hook_event_name === 'SessionStart' && input.source !== 'compact') return
  const md = read(path)
  const s = sections(md)
  const upkeep = [
    "Keeping these statuses current is your job, not the user's: never ask the user to set, change, or clear a marker.",
    `Change markers only through ${executable()} --file ${JSON.stringify(path)} status so every change is logged.`,
  ]
  const todo = context(s.todo, s, upkeep)
  console.log([instructions(path), ...(todo === undefined ? [] : [todo, logsHint(path)])].join('\n\n'))
}

function option(args: string[], name: string): string | undefined {
  const at = args.indexOf(name)
  if (at < 0) return undefined
  const value = args[at + 1]
  if (value === undefined) fail(`${name} needs a value`)
  args.splice(at, 2)
  return value
}

function statusOf(value: string): Status {
  const status = marks[value] || value
  if (!statuses.has(status as Status)) fail(`unknown status: ${value}`)
  return status as Status
}

function findItem(md: string, selector: string) {
  const list = items(sections(md).todo)
  const wanted = selector.replace(/^id:/, '')
  const found = list.filter(item => item.id === wanted || keyOf(item.text) === keyOf(selector) || (item.label !== undefined && keyOf(item.label) === keyOf(selector)))
  if (found.length === 0) fail(`no todo item matches: ${selector}`)
  if (found.length > 1) fail(`todo item is ambiguous: ${selector}`)
  return found[0]!
}

function mutate(path: string, verb: string, args: string[]): void {
  if (!existsSync(path)) fail(`notes file does not exist: ${path}`)
  const before = read(path)
  if (verb === 'show') {
    process.stdout.write(before)
    return
  }
  if (verb === 'status') {
    const reason = option(args, '--reason')
    if (args.length !== 2) fail('status needs <id-or-exact-label> <status>')
    const item = findItem(before, args[0]!)
    const to = statusOf(args[1]!)
    const body = cycleItem(sections(before).todo, idOf(item), () => to, reason)
    const changed = items(body).find(one => idOf(one) === idOf(item)) || { ...item, status: to }
    const md = addLogs(setTodo(before, body), [logRow({ at: Date.now(), actor: 'codex', action: 'status', item: changed, from: item.status, to, note: reason })])
    save(path, md, 'todo')
    notify(path, [{ item: changed, from: item.status, to }])
    console.log(`${markOf(to)} ${changed.label || changed.text}`)
    return
  }
  const text = args.join(' ').trim()
  if (text === '') fail(`${verb} needs text`)
  if (verb === 'add') {
    const current = sections(before).todo
    if (items(current).some(item => keyOf(item.text) === keyOf(text))) fail(`todo item already exists: ${text}`)
    const body = format(withIds(parse([current, `- [ ] ${text}`].filter(Boolean).join('\n'))))
    const item = items(body).find(one => keyOf(one.text) === keyOf(text))!
    const md = addLogs(setTodo(before, body), [logRow({ at: Date.now(), actor: 'codex', action: 'added', item, to: 'todo' })])
    save(path, md, 'todo')
    notify(path, [{ item, to: 'todo' }])
    console.log(`${item.id} ${item.text}`)
    return
  }
  if (verb === 'objective') {
    const md = addLogs(setObjectives(before, text), [logRow({ at: Date.now(), actor: 'codex', action: 'objective', note: text })])
    save(path, md, 'objective')
    return
  }
  if (verb === 'update') {
    const md = addLogs(addUpdate(before, new Date().toISOString().replace(/\.\d{3}Z$/, 'Z'), text), [logRow({ at: Date.now(), actor: 'codex', action: 'update', note: text })])
    save(path, md, 'update')
    return
  }
  fail(`unknown command: ${verb}`)
}

const args = process.argv.slice(2)
if (args[0] === 'hook') hook()
else {
  const file = option(args, '--file')
  if (file === undefined) fail('--file is required')
  const verb = args.shift()
  if (verb === undefined) fail('usage: notes-keeping-codex --file <path> show | status <item> <status> | add|objective|update <text>')
  mutate(resolve(file), verb, args)
}
